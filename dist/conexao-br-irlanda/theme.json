{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": { "palette": [
      { "slug": "verde", "color": "#147a53", "name": "Verde Conexão" },
      { "slug": "laranja", "color": "#f28a24", "name": "Laranja Conexão" },
      { "slug": "creme", "color": "#fff9f1", "name": "Creme" },
      { "slug": "texto", "color": "#16342b", "name": "Texto" }
    ] },
    "layout": { "contentSize": "760px", "wideSize": "1200px" },
    "spacing": { "spacingSizes": [{ "slug": "20", "size": "1rem", "name": "Pequeno" }, { "slug": "40", "size": "2rem", "name": "Médio" }, { "slug": "60", "size": "4rem", "name": "Grande" }] },
    "typography": { "fluid": true, "fontFamilies": [{ "fontFamily": "system-ui, sans-serif", "slug": "sans", "name": "Sans serif" }] }
  },
  "styles": {
    "color": { "background": "var:preset|color|creme", "text": "var:preset|color|texto" },
    "typography": { "fontFamily": "var:preset|font-family|sans", "lineHeight": "1.6" },
    "elements": { "link": { "color": { "text": "var:preset|color|verde" } }, "button": { "color": { "background": "var:preset|color|laranja", "text": "#ffffff" }, "border": { "radius": "999px" } } }
  },
  "templateParts": [
    { "name": "header", "title": "Cabeçalho", "area": "header" },
    { "name": "footer", "title": "Rodapé", "area": "footer" }
  ]
}
