      "error": "NO_AUTH",
      "status_code": 401
    }
  },

  "users_me_invalid_token": {
    "_doc": "VERBATIM live capture, 2026-10-04, GET /v3/users/me/ with a deliberately invalid bearer token. Proves the API distinguishes NO_AUTH from INVALID_AUTH, so an expired or invalid token is a distinguishable, truthful failure.",
    "status_code": 401,
    "body": {
      "error_description": "The OAuth token you provided was invalid.",
      "status_code": 401,
      "error": "INVALID_AUTH"
    }
  },

