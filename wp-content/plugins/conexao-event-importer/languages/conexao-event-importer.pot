#. Name of the plugin
#: wp-content/plugins/conexao-event-importer/conexao-event-importer.php:1
msgid "Conexão BR Irlanda — Event Importer (Local Tools)"
msgstr ""

#. Description of the plugin
#: wp-content/plugins/conexao-event-importer/conexao-event-importer.php:1
msgid "Local-only event import/export tooling. Fetches, normalizes, deduplicates, and imports events from configured external sources into the local WordPress database. Event images are downloaded into the Media Library locally, then the complete event data (with embedded images) is exported to JSON for import into the production WordPress.com site. Production-critical event runtime behavior (meta/taxonomy registration, _event_status, public query filtering, status admin UI) lives in the separate \"Conexão BR Irlanda — Event Runtime\" plugin."
msgstr ""

