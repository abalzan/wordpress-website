/* Event Importer Admin Styles */
.conexao-source-status {
	display: inline-block;
	padding: 2px 10px;
	border-radius: 3px;
	font-size: 12px;
	font-weight: 600;
	text-transform: uppercase;
}

.conexao-source-status--active {
	background: #edf7ed;
	color: #1e7e34;
	border: 1px solid #b7e1b7;
}

.conexao-source-status--inactive {
	background: #fef7e7;
	color: #9c6b1e;
	border: 1px solid #f5d9a0;
}

.conexao-source-error {
	color: #cc0000;
	font-size: 12px;
}

.conexao-import-summary {
	display: flex;
	gap: 24px;
	margin: 20px 0;
	flex-wrap: wrap;
}

.conexao-import-stat {
	background: #fff;
	border: 1px solid #ccd0d4;
	border-radius: 4px;
	padding: 16px 20px;
	min-width: 220px;
}

.conexao-import-stat-label {
	display: block;
	font-size: 12px;
	text-transform: uppercase;
	letter-spacing: 0.5px;
	color: #646970;
	margin-bottom: 6px;
}

.conexao-import-stat-value {
	display: block;
	font-size: 18px;
	font-weight: 600;
	color: #1d2327;
}

.conexao-source-list {
	margin: 10px 0 20px;
}

.conexao-source-list li {
	margin-bottom: 6px;
	font-size: 14px;
}

.conexao-source-indicator {
	display: inline-block;
	width: 20px;
	text-align: center;
}

.conexao-source-indicator--active {
	color: #1e8e3e;
}

.conexao-source-indicator--inactive {
	color: #cc0000;
}

.conexao-source-form {
	margin-top: 20px;
	max-width: 700px;
}

/* Event status badges on the admin list */
.conexao-status-badge {
	display: inline-block;
	padding: 3px 10px;
	border-radius: 3px;
	font-size: 11px;
	font-weight: 600;
	text-transform: uppercase;
	letter-spacing: 0.3px;
}

.conexao-status-badge--published,
.conexao-status-badge--success {
	background: #edf7ed;
	color: #1e7e34;
	border: 1px solid #b7e1b7;
}

.conexao-status-badge--needs_review,
.conexao-status-badge--warning {
	background: #fff8e1;
	color: #8a6d00;
	border: 1px solid #f0e0a0;
}

.conexao-status-badge--draft {
	background: #f1f1f1;
	color: #50575e;
	border: 1px solid #d5d5d5;
}

.conexao-status-badge--source_not_found,
.conexao-status-badge--failed,
.conexao-status-badge--error {
	background: #fdeaea;
	color: #b32d2e;
	border: 1px solid #f0c0c0;
}

.conexao-status-badge--expired {
	background: #f1f1f1;
	color: #646970;
	border: 1px solid #d5d5d5;
}

.conexao-status-badge--rejected {
	background: #fdeaea;
	color: #b32d2e;
	border: 1px solid #f0c0c0;
}

.conexao-status-badge--partial {
	background: #fff8e1;
	color: #8a6d00;
	border: 1px solid #f0e0a0;
}

.conexao-source-label {
	font-size: 12px;
	color: #50575e;
}

/* Source type badges */
.conexao-source-type {
	display: inline-block;
	padding: 3px 10px;
	border-radius: 3px;
	font-size: 11px;
	font-weight: 600;
	text-transform: uppercase;
	letter-spacing: 0.3px;
}

.conexao-source-type--icalendar {
	background: #e8f0fe;
	color: #1a73e8;
	border: 1px solid #a8c7fa;
}

.conexao-source-type--website {
	background: #f1f1f1;
	color: #50575e;
	border: 1px solid #d5d5d5;
}

.conexao-source-type--facebook {
	background: #e7f0ff;
	color: #1877f2;
	border: 1px solid #b8d4f0;
}

.conexao-source-type--instagram {
	background: #fdf0f4;
	color: #c13584;
	border: 1px solid #f0c0d0;
}

.conexao-source-type--eventbrite {
	background: #fff0e6;
	color: #f05537;
	border: 1px solid #f5c0a0;
}

/* Delete button styling - destructive action */
.button-link-delete {
	color: #b32d2e !important;
	border-color: #b32d2e !important;
	background: #fff !important;
}

.button-link-delete:hover,
.button-link-delete:focus {
	color: #fff !important;
	background: #b32d2e !important;
	border-color: #b32d2e !important;
}

.button-link-delete:active {
	color: #fff !important;
	background: #a02728 !important;
	border-color: #a02728 !important;
}

/* Event Export / Import transfer pages */
.conexao-event-transfer .conexao-transfer-card {
	background: #fff;
	border: 1px solid #ccd0d4;
	border-radius: 4px;
	padding: 20px 24px;
	margin: 20px 0;
	max-width: 720px;
}

.conexao-event-transfer .conexao-transfer-card h2 {
	margin-top: 0;
	font-size: 16px;
}

.conexao-event-transfer .conexao-transfer-count {
	font-size: 15px;
	margin: 12px 0 16px;
}

.conexao-event-transfer .conexao-transfer-count strong {
	font-size: 22px;
	color: #1d2327;
}

.conexao-event-transfer .conexao-transfer-list,
.conexao-event-transfer .conexao-import-stats,
.conexao-event-transfer .conexao-import-errors {
	margin: 8px 0 0;
	padding-left: 20px;
	list-style: disc;
}

.conexao-event-transfer .conexao-transfer-list li,
.conexao-event-transfer .conexao-import-stats li,
.conexao-event-transfer .conexao-import-errors li {
	margin-bottom: 4px;
	font-size: 14px;
}

.conexao-event-transfer form p {
	margin: 12px 0;
}

.conexao-event-transfer form input[type="file"],
.conexao-event-transfer form select {
	margin-top: 6px;
}

.conexao-event-transfer form select {
	min-width: 260px;
}

.conexao-event-transfer form .description {
	display: block;
	margin-top: 6px;
}

/* ============================================================
 * Import result notice (after "Run Import Now")
 * ============================================================ */
.conexao-import-notice {
	border-left-width: 4px;
}

.conexao-import-notice p {
	margin: 0.5em 0;
}

.conexao-import-notice p:first-child {
	margin-top: 0.5em;
}

.conexao-import-notice p:last-child {
	margin-bottom: 0.5em;
}

/* Collapsible error details */
.conexao-error-details {
	margin: 8px 0;
	padding: 8px 12px;
	background: #f6f7f7;
	border: 1px solid #dcdcde;
	border-radius: 4px;
}

.conexao-error-details summary {
	cursor: pointer;
	font-weight: 600;
	color: #1d2327;
}

.conexao-error-details summary:hover {
	color: #2271b1;
}

.conexao-error-details code {
	display: block;
	margin-top: 8px;
	padding: 8px 10px;
	background: #fff;
	border: 1px solid #dcdcde;
	border-radius: 3px;
	font-size: 12px;
	white-space: pre-wrap;
	word-break: break-all;
	max-height: 200px;
	overflow-y: auto;
}

/* Failed events list inside the notice */
.conexao-failed-events-list {
	margin: 8px 0 0;
	padding-left: 20px;
	list-style: disc;
}

.conexao-failed-events-list li {
	margin-bottom: 6px;
	font-size: 13px;
}

.conexao-failed-events-list li details {
	margin-top: 4px;
}

.conexao-failed-events-list li details summary {
	font-size: 12px;
	color: #646970;
	cursor: pointer;
}

.conexao-failed-events-list li details code {
	display: block;
	margin-top: 4px;
	padding: 6px 8px;
	background: #fff;
	border: 1px solid #dcdcde;
	border-radius: 3px;
	font-size: 11px;
	white-space: pre-wrap;
	word-break: break-all;
	max-height: 150px;
	overflow-y: auto;
}

/* ============================================================
 * Import running / loading state
 * ============================================================ */
.conexao-import-running {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	color: #2271b1;
	font-weight: 600;
}

.conexao-import-running .spinner {
	float: none;
	margin: 0;
}

.conexao-import-running-text {
	font-size: 13px;
}

/* Disable import buttons while running */
.conexao-importing .button[type="submit"] {
	opacity: 0.6;
	pointer-events: none;
}

/* Import dashboard section spacing */
.conexao-import-dashboard h2 {
	margin-top: 28px;
}

.conexao-import-dashboard .conexao-import-summary {
	margin-top: 12px;
}

/* Source table action buttons spacing */
.conexao-event-sources .widefat td form {
	margin-right: 4px;
}

.conexao-event-sources .widefat td form:last-child {
	margin-right: 0;
}

/* History status badges */
.conexao-status-badge--success {
	background: #edf7ed;
	color: #1e7e34;
	border: 1px solid #b7e1b7;
}

.conexao-status-badge--warning {
	background: #fff8e1;
	color: #8a6d00;
	border: 1px solid #f0e0a0;
}

.conexao-status-badge--partial {
	background: #fff8e1;
	color: #8a6d00;
	border: 1px solid #f0e0a0;
}

.conexao-status-badge--failed,
.conexao-status-badge--error {
	background: #fdeaea;
	color: #b32d2e;
	border: 1px solid #f0c0c0;
}