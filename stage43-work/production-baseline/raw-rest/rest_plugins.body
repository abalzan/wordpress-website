[{"plugin":"akismet\/akismet","status":"active","name":"Akismet Anti-spam: Spam Protection","plugin_uri":"https:\/\/akismet.com\/","author":"Automattic - Anti-spam Team","author_uri":"https:\/\/automattic.com\/wordpress-plugins\/","description":{"raw":"Used by millions, Akismet is quite possibly the best way in the world to <strong>protect your blog from spam<\/strong>. Akismet Anti-spam keeps your site protected even while you sleep. To get started: activate the Akismet plugin and then go to your Akismet Settings page to set up your API key.","rendered":"Used by millions, Akismet is quite possibly the best way in the world to <strong>protect your blog from spam<\/strong>. Akismet Anti-spam keeps your site protected even while you sleep. To get started: activate the Akismet plugin and then go to your Akismet Settings page to set up your API key. <cite>By <a href=\"https:\/\/automattic.com\/wordpress-plugins\/\">Automattic - Anti-spam Team<\/a>.<\/cite>"},"version":"5.7.2","network_only":false,"requires_wp":"5.8","requires_php":"7.2","textdomain":"akismet","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/akismet\/akismet","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"classic-editor\/classic-editor","status":"inactive","name":"Classic Editor","plugin_uri":"https:\/\/wordpress.org\/plugins\/classic-editor\/","author":"WordPress Contributors","author_uri":"https:\/\/github.com\/WordPress\/classic-editor\/","description":{"raw":"Enables the WordPress classic editor and the old-style Edit Post screen with TinyMCE, Meta Boxes, etc. Supports the older plugins that extend this screen.","rendered":"Enables the WordPress classic editor and the old-style Edit Post screen with TinyMCE, Meta Boxes, etc. Supports the older plugins that extend this screen. <cite>By <a href=\"https:\/\/github.com\/WordPress\/classic-editor\/\">WordPress Contributors<\/a>.<\/cite>"},"version":"1.7.0","network_only":false,"requires_wp":"4.9","requires_php":"5.2.4","textdomain":"classic-editor","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/classic-editor\/classic-editor","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"conexao-content\/conexao-content","status":"active","name":"Conex\u00e3o BR Irlanda - Content","plugin_uri":"","author":"Conex\u00e3o BR Irlanda","author_uri":"","description":{"raw":"Secao de conteudo, shortcodes, e helpers para o portal Conex\u00e3o BR Irlanda","rendered":"Secao de conteudo, shortcodes, e helpers para o portal Conex\u00e3o BR Irlanda <cite>By Conex\u00e3o BR Irlanda.<\/cite>"},"version":"1.0.0","network_only":false,"requires_wp":"6.0","requires_php":"7.4","textdomain":"conexao-content","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/conexao-content\/conexao-content","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"conexao-data-model\/conexao-data-model","status":"active","name":"Conex\u00e3o BR Irlanda Data Model","plugin_uri":"","author":"","author_uri":"","description":{"raw":"Content types, shared taxonomies, and editorial fields for the Conex\u00e3o BR Irlanda portal.","rendered":"Content types, shared taxonomies, and editorial fields for the Conex\u00e3o BR Irlanda portal."},"version":"1.6.0","network_only":false,"requires_wp":"","requires_php":"","textdomain":"conexao-data-model","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/conexao-data-model\/conexao-data-model","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"conexao-admin-ux\/conexao-admin-ux","status":"active","name":"Conex\u00e3o BR Irlanda \u2014 Admin UX","plugin_uri":"","author":"","author_uri":"","description":{"raw":"Reusable, professional CMS admin experience for Eventos, Not\u00edcias, Guias, Empregos and Apoiadores. Replaces generic meta boxes with structured sections, clear statuses, bulk actions, duplicate\/archive workflows and dashboard summaries.","rendered":"Reusable, professional CMS admin experience for Eventos, Not\u00edcias, Guias, Empregos and Apoiadores. Replaces generic meta boxes with structured sections, clear statuses, bulk actions, duplicate\/archive workflows and dashboard summaries."},"version":"1.0.6","network_only":false,"requires_wp":"6.4","requires_php":"8.0","textdomain":"conexao-admin-ux","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/conexao-admin-ux\/conexao-admin-ux","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"conexao-event-importer\/conexao-event-importer","status":"active","name":"Conex\u00e3o BR Irlanda \u2014 Event Importer (Local Tools)","plugin_uri":"","author":"","author_uri":"","description":{"raw":"Local-only event import\/export tooling. Fetches, normalizes, deduplicates, and imports events from configured external sources into the local WordPress database. Event images are downloaded into the Media Library locally, then the complete event data (with embedded images) is exported to JSON for import into the production WordPress.com site. Production-critical event runtime behavior (meta\/taxonomy registration, _event_status, public query filtering, status admin UI) lives in the separate \"Conex\u00e3o BR Irlanda \u2014 Event Runtime\" plugin.","rendered":"Local-only event import\/export tooling. Fetches, normalizes, deduplicates, and imports events from configured external sources into the local WordPress database. Event images are downloaded into the Media Library locally, then the complete event data (with embedded images) is exported to JSON for import into the production WordPress.com site. Production-critical event runtime behavior (meta\/taxonomy registration, _event_status, public query filtering, status admin UI) lives in the separate &#8220;Conex\u00e3o BR Irlanda \u2014 Event Runtime&#8221; plugin."},"version":"1.7.1","network_only":false,"requires_wp":"","requires_php":"","textdomain":"conexao-event-importer","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/conexao-event-importer\/conexao-event-importer","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"conexao-event-runtime\/conexao-event-runtime","status":"active","name":"Conex\u00e3o BR Irlanda \u2014 Event Runtime","plugin_uri":"","author":"","author_uri":"","description":{"raw":"Production event runtime. Registers event metadata and the Town\/City taxonomy, owns the _event_status visibility gate for public event queries, and provides the event status admin UI. Contains no import\/export tooling \u2014 see Conex\u00e3o BR Irlanda Event Importer (local-only).","rendered":"Production event runtime. Registers event metadata and the Town\/City taxonomy, owns the _event_status visibility gate for public event queries, and provides the event status admin UI. Contains no import\/export tooling \u2014 see Conex\u00e3o BR Irlanda Event Importer (local-only)."},"version":"1.2.1","network_only":false,"requires_wp":"","requires_php":"","textdomain":"conexao-event-runtime","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/conexao-event-runtime\/conexao-event-runtime","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"conexao-leisure-migration\/conexao-leisure-migration","status":"active","name":"Conex\u00e3o BR Irlanda \u2014 Lazer Migration","plugin_uri":"","author":"","author_uri":"","description":{"raw":"Export and import the \/lazer\/ (leisure) dataset as a self-contained ZIP package containing data.json and the actual image files from the Media Library. Imports into another installation with dry-run preview, dedupe by stable UUID + image ID, Media Library attachment creation, legacy-data cleanup, and post-import verification. Production images are always local \u2014 no dependency on Wikimedia Commons for delivery.","rendered":"Export and import the \/lazer\/ (leisure) dataset as a self-contained ZIP package containing data.json and the actual image files from the Media Library. Imports into another installation with dry-run preview, dedupe by stable UUID + image ID, Media Library attachment creation, legacy-data cleanup, and post-import verification. Production images are always local \u2014 no dependency on Wikimedia Commons for delivery."},"version":"2.1.0","network_only":false,"requires_wp":"","requires_php":"","textdomain":"conexao-leisure-migration","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/conexao-leisure-migration\/conexao-leisure-migration","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"polldaddy\/polldaddy","status":"inactive","name":"Crowdsignal Dashboard - Polls, Surveys &amp; more","plugin_uri":"https:\/\/wordpress.org\/plugins\/polldaddy\/","author":"Automattic, Inc.","author_uri":"","description":{"raw":"Create and manage Crowdsignal polls and ratings in WordPress","rendered":"Create and manage Crowdsignal polls and ratings in WordPress <cite>By Automattic, Inc..<\/cite>"},"version":"3.1.8","network_only":false,"requires_wp":"","requires_php":"","textdomain":"polldaddy","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/polldaddy\/polldaddy","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"crowdsignal-forms\/crowdsignal-forms","status":"inactive","name":"Crowdsignal Forms","plugin_uri":"https:\/\/crowdsignal.com\/crowdsignal-forms\/","author":"Automattic","author_uri":"https:\/\/automattic.com\/","description":{"raw":"Crowdsignal Form Blocks","rendered":"Crowdsignal Form Blocks <cite>By <a href=\"https:\/\/automattic.com\/\">Automattic<\/a>.<\/cite>"},"version":"1.8.2","network_only":false,"requires_wp":"","requires_php":"","textdomain":"crowdsignal-forms","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/crowdsignal-forms\/crowdsignal-forms","targetHints":{"allow":["GET","POST","PUT","PATCH","D