rformance, and marketing tools made by WordPress experts. Jetpack keeps your site protected so you can focus on more important things.","rendered":"Security, performance, and marketing tools made by WordPress experts. Jetpack keeps your site protected so you can focus on more important things. <cite>By <a href=\"https:\/\/jetpack.com\">Automattic<\/a>.<\/cite>"},"version":"16.3-a.3","network_only":false,"requires_wp":"7.0","requires_php":"7.4","textdomain":"jetpack","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/jetpack\/jetpack","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"layout-grid\/index","status":"inactive","name":"Layout Grid","plugin_uri":"","author":"Automattic","author_uri":"https:\/\/automattic.com","description":{"raw":"Let any blocks align to a global grid","rendered":"Let any blocks align to a global grid <cite>By <a href=\"https:\/\/automattic.com\">Automattic<\/a>.<\/cite>"},"version":"1.8.5","network_only":false,"requires_wp":"","requires_php":"","textdomain":"layout-grid","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/layout-grid\/index","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"page-optimize\/page-optimize","status":"active","name":"Page Optimize","plugin_uri":"https:\/\/wordpress.org\/plugins\/page-optimize\/","author":"Automattic","author_uri":"http:\/\/automattic.com\/","description":{"raw":"Optimizes JS and CSS for faster page load and render in the browser.","rendered":"Optimizes JS and CSS for faster page load and render in the browser. <cite>By <a href=\"http:\/\/automattic.com\/\">Automattic<\/a>.<\/cite>"},"version":"0.6.3","network_only":false,"requires_wp":"","requires_php":"","textdomain":"page-optimize","_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/plugins\/page-optimize\/page-optimize","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}]}},{"plugin":"updraftplus\/updraftplus",