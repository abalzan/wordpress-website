[{"id":11,"date":"2026-08-16T15:20:11","date_gmt":"2026-08-16T14:20:11","guid":{"rendered":"https:\/\/conexaobr.ie\/sobre-nos\/","raw":"https:\/\/conexaobr.ie\/sobre-nos\/"},"modified":"2026-08-16T15:20:11","modified_gmt":"2026-08-16T14:20:11","password":"","slug":"sobre-nos","status":"publish","type":"page","link":"https:\/\/conexaobr.ie\/sobre-nos\/","title":{"raw":"Sobre N\u00f3s","rendered":"Sobre N\u00f3s"},"content":{"raw":"<!-- wp:heading --><h2>Quem somos<\/h2><!-- \/wp:heading -->\n<!-- wp:paragraph --><p>O Conex\u00e3o BR Irlanda \u00e9 o portal da comunidade brasileira na Irlanda. Nosso objetivo \u00e9 conectar, informar e apoiar brasileiros que vivem ou planejam viver na Irlanda.<\/p><!-- \/wp:paragraph -->\n<!-- wp:heading --><h2>Nossa Miss\u00e3o<\/h2><!-- \/wp:heading -->\n<!-- wp:paragraph --><p>Oferecer informa\u00e7\u00f5es relevantes, guias pr\u00e1ticos, eventos e uma rede de apoio para que cada brasileiro possa viver melhor na Irlanda.<\/p><!-- \/wp:paragraph -->\n<!-- wp:heading --><h2>Nossa Vis\u00e3o<\/h2><!-- \/wp:heading -->\n<!-- wp:paragraph --><p>Ser a principal refer\u00eancia para a comunidade brasileira na Irlanda, promovendo integra\u00e7\u00e3o, conhecimento e oportunidades.<\/p><!-- \/wp:paragraph -->\n<!-- wp:heading --><h2>Nossos Valores<\/h2><!-- \/wp:heading -->\n<!-- wp:list --><ul><li>Comunidade e solidariedade<\/li><li>Informa\u00e7\u00e3o de qualidade e verificada<\/li><li>Inclus\u00e3o e diversidade<\/li><li>Transpar\u00eancia e confian\u00e7a<\/li><\/ul><!-- \/wp:list -->","rendered":"<h2 class=\"wp-block-heading\">Quem somos<\/h2>\n<p class=\"wp-block-paragraph\">O Conex\u00e3o BR Irlanda \u00e9 o portal da comunidade brasileira na Irlanda. Nosso objetivo \u00e9 conectar, informar e apoiar brasileiros que vivem ou planejam viver na Irlanda.<\/p>\n<h2 class=\"wp-block-heading\">Nossa Miss\u00e3o<\/h2>\n<p class=\"wp-block-paragraph\">Oferecer informa\u00e7\u00f5es relevantes, guias pr\u00e1ticos, eventos e uma rede de apoio para que cada brasileiro possa viver melhor na Irlanda.<\/p>\n<h2 class=\"wp-block-heading\">Nossa Vis\u00e3o<\/h2>\n<p class=\"wp-block-paragraph\">Ser a principal refer\u00eancia para a comunidade brasileira na Irlanda, promovendo integra\u00e7\u00e3o, conhecimento e oportunidades.<\/p>\n<h2 class=\"wp-block-heading\">Nossos Valores<\/h2>\n<ul class=\"wp-block-list\"><li>Comunidade e solidariedade<\/li><li>Informa\u00e7\u00e3o de qualidade e verificada<\/li><li>Inclus\u00e3o e diversidade<\/li><li>Transpar\u00eancia e confian\u00e7a<\/li><\/ul>","protected":false,"block_version":1},"excerpt":{"raw":"","rendered":"<p>Quem somos O Conex\u00e3o BR Irlanda \u00e9 o portal da comunidade brasileira na Irlanda. Nosso objetivo \u00e9 conectar, informar e apoiar brasileiros que vivem ou planejam viver na Irlanda. Nossa&hellip;<\/p>\n","protected":false},"author":283039558,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"advanced_seo_description":"","jetpack_seo_html_title":"","jetpack_seo_noindex":false,"jetpack_seo_schema_type":"","_wpcom_ai_launchpad_about_page":false,"_wpcom_ai_launchpad_gallery_page":false,"_wpcom_ai_launchpad_contact_page":false,"_wpcom_ai_launchpad_events_page":false,"_wpcom_ai_launchpad_video_page":false,"_wpcom_ai_launchpad_portfolio_piece":false,"_empregos_link":"","footnotes":""},"permalink_template":"https:\/\/conexaobr.ie\/%pagename%\/","generated_slug":"sobre-nos","class_list":["post-11","page","type-page","status-publish","hentry"],"jetpack_likes_enabled":true,"jetpack_sharing_enabled":true,"jetpack_shortlink":"https:\/\/wp.me\/PhnpqN-b","jetpack-related-posts":[],"_links":{"self":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/pages\/11","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}],"collection":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/conexaobr.ie\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":