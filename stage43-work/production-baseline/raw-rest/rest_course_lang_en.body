[{"id":11148,"date":"2026-08-28T09:11:08","date_gmt":"2026-08-28T08:11:08","guid":{"rendered":"https:\/\/conexaobr.ie\/?post_type=course_provider&#038;p=11148"},"modified":"2026-08-28T09:22:04","modified_gmt":"2026-08-28T08:22:04","slug":"hseland","status":"publish","type":"course_provider","link":"https:\/\/conexaobr.ie\/cursos\/hseland\/","title":{"rendered":"HSeLanD"},"content":{"rendered":"<p>HSeLanD is the Health Service Executive\u2019s (HSE) national online learning and development portal.<\/p>\n<p>Built on a fully integrated Learning and Talent Management System, HSeLanD is developed and maintained by the HSE National HR Capability and Culture function.<\/p>\n<p>The HSeLanD team works collaboratively with hospitals, HSE divisions, and teams to develop and deliver high quality online learning, training, and development opportunities to support the wider Irish health and social care workforce. <\/p>\n","protected":false},"excerpt":{"rendered":"<p>HSeLanD is the Health Service Executive\u2019s (HSE) national online learning and development portal.<\/p>\n<p>Built on a fully integrated Learning and Talent Management System, HSeLanD is developed and maintained by the HSE National HR Capability and Culture function.<\/p>\n<p>The HSeLanD team works collaboratively with hospitals, HSE divisions, and teams to develop and deliver high quality online learning, training, and development opportunities to support the wider Irish health and social care workforce. <\/p>\n","protected":false},"featured_media":0,"template":"","meta":{"advanced_seo_description":"","jetpack_seo_html_title":"","jetpack_seo_noindex":false,"jetpack_seo_schema_type":"","_provider_logo":0,"_provider_category":"Forma\u00e7\u00e3o Profissional","_provider_location":"Online \/ Irlanda","_provider_url":"https:\/\/www.hseland.ie","_provider_status":"published","_provider_order":15,"footnotes":""},"conexao_category":[],"conexao_county":[],"conexao_tag":[],"class_list":["post-11148","course_provider","type-