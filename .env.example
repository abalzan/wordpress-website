# Copy to .env only when you need to override local defaults.
# .env is git-ignored and must never be committed.

# --- Docker Compose (local WordPress + MySQL) ---------------------------
# Every value below matches the compose.yaml fallback defaults.
WORDPRESS_PORT=8080
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=local-root-password
WORDPRESS_DEBUG=1

# --- REST scripts (scripts/*-rest.py, *-http-verify.py) -----------------
# Only needed by the Python REST/HTTP verification scripts, which
# authenticate against a WordPress application password.
# Create one in wp-admin → Users → Profile → Application Passwords.
WP_USERNAME='username'
WP_APPLICATION_PASSWORD='password'
